{
  "schema": 3,
  "nodeId": "rc-gateway-udp-lab",
  "admin": {
    "bind": "127.0.0.1:18080"
  },
  "security": {
    "requireAllowlist": true,
    "commandPlaneEnabled": false
  },
  "tunnels": [],
  "udpTunnels": [
    {
      "id": "udp-field-to-consumer",
      "field": {
        "mode": "listen",
        "bind": "0.0.0.0:16001",
        "allowedCidrs": ["10.0.0.0/8"]
      },
      "consumer": {
        "mode": "connect",
        "address": "127.0.0.1:26001"
      },
      "idleTimeoutSeconds": 60,
      "maxSessions": 1024,
      "maxDatagramBytes": 65507
    }
  ]
}
