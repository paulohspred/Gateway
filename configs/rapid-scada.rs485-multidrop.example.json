{
  "schema": 3,
  "nodeId": "rc-gateway-rapid-rs485-multidrop",
  "admin": {"bind": "127.0.0.1:18080"},
  "security": {
    "requireAllowlist": true,
    "commandPlaneEnabled": false
  },
  "serialProviders": [
    {
      "id": "rapid-rs485-bus-1",
      "socket": "/run/rc-gateway/rapid-rs485-bus-1.sock",
      "device": "/dev/ttyUSB0",
      "standard": "rs485",
      "baudRate": 9600,
      "dataBits": 8,
      "parity": "even",
      "stopBits": "1",
      "readTimeoutMilliseconds": 250,
      "rts": false,
      "dtr": false
    }
  ],
  "tunnels": [
    {
      "id": "rapid-rs485-bus-1-to-scada",
      "field": {
        "mode": "connect",
        "network": "unix",
        "address": "/run/rc-gateway/rapid-rs485-bus-1.sock",
        "reconnectSeconds": 1
      },
      "consumer": {
        "mode": "listen",
        "network": "tcp",
        "bind": "127.0.0.1:25100",
        "keepAliveSeconds": 30
      }
    }
  ]
}
