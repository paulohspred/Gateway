[Unit]
Description=RC Identity, Administration and Commissioning control plane
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=rc-admin
Group=rc-admin
WorkingDirectory=/opt/rc-gateway/current
EnvironmentFile=/etc/rc-admin.env
ExecStartPre=/opt/rc-gateway/current/bin/rc-admin --check-config --bind 127.0.0.1:18110 --state /var/lib/rc-admin/state.json
ExecStart=/opt/rc-gateway/current/bin/rc-admin --bind 127.0.0.1:18110 --state /var/lib/rc-admin/state.json
Restart=on-failure
RestartSec=3s
RuntimeDirectory=rc-admin
StateDirectory=rc-admin
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target
