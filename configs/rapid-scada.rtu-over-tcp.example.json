{
  "schema": 3,
  "nodeId": "rc-gateway-rapid-rtu-over-tcp",
  "admin": {"bind": "127.0.0.1:18080"},
  "security": {
    "requireAllowlist": true,
    "commandPlaneEnabled": false
  },
  "tunnels": [
    {
      "id": "serial-server-rtu-to-rapid",
      "pairTimeoutSeconds": 30,
      "writeTimeoutSeconds": 30,
      "drainTimeoutSeconds": 2,
      "field": {
        "mode": "listen",
        "network": "tcp",
        "bind": "0.0.0.0:15003",
        "allowedCidrs": ["10.0.0.0/8"],
        "keepAliveSeconds": 30
      },
      "consumer": {
        "mode": "listen",
        "network": "tcp",
        "bind": "127.0.0.1:25003",
        "keepAliveSeconds": 30
      }
    }
  ]
}
